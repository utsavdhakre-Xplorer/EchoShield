# MongoDB
# Set this in your local backend/.env file. Never commit real credentials.
MONGO_URI=mongodb://localhost:27017/echoshield

# JWT (generate a long random secret; never use this placeholder in production)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# Deepfake model (optional path to trained weights)
DEEPFAKE_MODEL_PATH=

# Deepfake detection threshold (0.0 - 1.0)
DEEPFAKE_THRESHOLD=0.6

# Anthropic API key for AI Negotiator (optional)
ANTHROPIC_API_KEY=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
